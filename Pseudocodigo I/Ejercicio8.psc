Algoritmo porcentajes
  Definir ninos, ninas, total, pNinos, pNinas Como Real
  Escribir "Número de niños:"
  Leer ninos
  Escribir "Número de niñas:"
  Leer ninas
  total <- ninos + ninas
  pNinos <- ninos * 100 / total
  pNinas <- ninas * 100 / total
  Escribir "Niños: ", pNinos, "%"
  Escribir "Niñas: ", pNinas, "%"
FinAlgoritmo